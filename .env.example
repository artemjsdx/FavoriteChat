# ================================
# FavoriteChat v3 — .env.example
# Скопируй в .env и заполни нужные поля
# ================================

# Токен главного бота (от @BotFather) — ОБЯЗАТЕЛЬНО
MAIN_BOT_TOKEN=

# PostgreSQL — ОБЯЗАТЕЛЬНО
DATABASE_URL=postgresql://fchat:fchat123@localhost:5432/favoritechat

# Порт Express-сервера (по умолчанию 5000)
PORT=5000

# Публичный URL для вебхука Telegram (если не задан — используется polling)
# Для Termux оставь пустым — polling работает лучше
PUBLIC_URL=

# Уровень логирования: trace / debug / info / warn / error
LOG_LEVEL=info

# Telegram ID владельца бота (числовой) — для защиты и уведомлений
# Узнай свой ID: напиши @userinfobot
OWNER_TELEGRAM_ID=

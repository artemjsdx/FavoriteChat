# ==============================
# FavoriteChat — .env.example
# Скопируй в .env и заполни
# ==============================

# PostgreSQL — обязательно
DATABASE_URL=postgresql://user:password@localhost:5432/favoritechat

# Порт API-сервера (по умолчанию 5000)
PORT=5000

# Порт веб-дашборда (по умолчанию 3000)
DASHBOARD_PORT=3000

# Публичный URL для Telegram вебхуков (webhook-режим)
# Если НЕ задан — автоматически включается polling-режим (для Termux)
# Для Termux + ngrok: PUBLIC_URL=https://xxxx.ngrok-free.app
PUBLIC_URL=

# Режим опроса Telegram (polling)
# true  — всегда polling (рекомендуется для Termux без ngrok)
# false — всегда webhook (нужен PUBLIC_URL)
# (пусто) — автоматически: polling если нет PUBLIC_URL, иначе webhook
POLLING_MODE=

# Токен главного бота (необязательно, для будущих фич)
MAIN_BOT_TOKEN=

# Уровень логирования: trace / debug / info / warn / error
LOG_LEVEL=info
